{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "functions": {
    "index.js": {
      "includeFiles": "server/src/db/migrations/**/*.sql"
    },
    "api/index.js": {
      "includeFiles": "server/src/db/migrations/**/*.sql"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/inicial.html" },
    { "source": "/api", "destination": "/saude" },
    { "source": "/api/:path*", "destination": "/:path*" }
  ]
}