{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "functions": {
    "index.js": {
      "includeFiles": "{server/src/db/migrations/**/*.sql,public/inicial.html}"
    },
    "api/index.js": {
      "includeFiles": "{server/src/db/migrations/**/*.sql,public/inicial.html}"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": "/saude" },
    { "source": "/api/:path*", "destination": "/:path*" }
  ]
}