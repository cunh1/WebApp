# Ambiente local: o backend Express serve também o frontend na mesma origem.
NODE_ENV=development
PORT=3000

# Persistência LOCAL (desenvolvimento). Não use arquivo SQLite local como banco de produção no Vercel.
DB_PATH=./data/app.sqlite
UPLOADS_PATH=./uploads

# Ajuste somente se precisar reduzir o custo de hash de senha em máquina de desenvolvimento.
# Em produção, mantenha o padrão seguro.
# SCRYPT_N=131072

# Produção no Vercel exige uma migração para banco remoto persistente e armazenamento remoto
# de anexos. DB_PATH e UPLOADS_PATH acima são caminhos de disco local e não atendem isso.
